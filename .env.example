# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Shared secret Instantly must send as the X-Webhook-Secret header (or ?secret=)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Classification
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Replies classified below this confidence go to Discord instead of being drafted
CONFIDENCE_THRESHOLD=0.7

# Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional - only needed if you later enable auto-send
INSTANTLY_API_KEY=
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2

# Template variables
SENDER_NAME=Raz
SENDER_COMPANY=
CALENDAR_LINK=https://cal.com/your-handle
