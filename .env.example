# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Shared secret Instantly must send as the X-Webhook-Secret header (or ?secret=)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Classification
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Replies classified below this confidence go to Discord instead of being drafted
CONFIDENCE_THRESHOLD=0.7

# Catch-all Discord channel (per-client sub-channels live in config/clients.json)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# One Instantly API key per client workspace. The env var NAMES are declared in
# config/clients.json (instantlyApiKeyEnv); define each one here.
INSTANTLY_API_KEY_RAZ=
INSTANTLY_API_KEY_ACME=
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2

# Client profiles normally live in config/clients.json. On hosts without a
# persistent file you can instead paste the whole JSON into this var:
# CLIENTS_JSON={"raz":{...}}
